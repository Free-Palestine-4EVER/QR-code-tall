# Copy to client/.env.local for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.
# Get these from Firebase Console → Project settings → Your apps → Web app → SDK setup (config object).
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project
VITE_FB_STORAGE_BUCKET=your-project.appspot.com
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
